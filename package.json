{
  "name": "acme-internal-tools",
  "private": true,
  "workspaces": [
    "platform",
    "web"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "npm run setup -w web",
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w web",
    "db:migrate": "npm run db:migrate -w web",
    "db:seed": "npm run db:seed -w web",
    "db:reset": "npm run db:reset -w web",
    "db:generate": "npm run db:generate -w web",
    "test": "npm run test -w platform && npm run test -w web",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck -w platform && npm run typecheck -w web",
    "new-app": "npm run new-app -w web --"
  }
}
